# ---- Bodhan speech models (ASR, translation, TTS) ----
BODHAN_ASR_API_KEY=
BODHAN_TRANSLATE_API_KEY=
BODHAN_TTS_API_KEY=
BODHAN_BASE_URL=https://api.bodhan.ai
BODHAN_VOICE_CATALOG_PATH=backend/voices/data/voice_catalog.json
# true: speech recognition, translation and voices wait out Bodhan rate limits instead of moving to OpenRouter
BODHAN_ONLY=false
# Concurrent Bodhan requests per stage
MODEL_REQUEST_WORKERS=4
# Translation style: native script, or codemix (keeps common English words)
TRANSLATION_SCRIPT=codemix
# OpenRouter: runs transcription, translation and voices whenever Bodhan cannot answer
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_ASR_MODEL=google/gemini-3.5-transcribe
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts
OPENROUTER_CLONE_MODEL=fish-audio/s2.1-pro
# Shorten lines that would be rushed so they fit their original timing
TIMING_FIT=true

# ---- Server ----
HOST=0.0.0.0
PORT=8001
# Set a password to require sign-in for the studio UI/API (recommended on a public host)
STUDIO_PASSWORD=

# ---- Scheduling (16-core CPU host) ----
# Jobs whose model stages may run at the same time
JOB_WORKERS=2
# CPU-heavy stages (diarization, lip sync) running at once
RENDER_WORKERS=1

# ---- Media limits ----
JOBS_DIR=jobs
MAX_VIDEO_MINUTES=30
MAX_UPLOAD_MB=2048
# Sources taller than this are downscaled before processing (faster renders)
MAX_VIDEO_HEIGHT=720
# Background bed: separate = Demucs removes the original voices (no echo); duck = lower the original mix; none
BACKGROUND_MODE=separate
SEPARATION_MODEL=htdemucs
# separation backend: demucs (above) or roformer (Mel-RoFormer vocals by Kimberley Jensen via audio-separator in .venv-separate: 10 dB less voice left in the bed than Demucs on Jailer 2, ~20 s per minute)
SEPARATION_BACKEND=roformer
ROFORMER_MODEL=vocals_mel_band_roformer.ckpt
SEPARATION_MAX_MINUTES=20
BACKGROUND_LEVEL=0.9
BACKGROUND_SPEECH_LEVEL=0.6
DUCK_LEVEL=0.6
DUCK_SPEECH_LEVEL=0.04

# ---- Compute ----
# auto picks cuda when nvidia-smi sees a GPU (H100 etc.), otherwise cpu
DEVICE=auto

# ---- Timing: every dubbed line fills exactly its original slot ----
# Lines are rewritten and re-voiced until they fit within this tempo band, then stretched to the exact slot
# exact: every line is stretched to fill its original slot precisely; natural: pace stays within 0.8x-1.35x
TIMING_MODE=exact
# pace band in exact mode; outside it a long line borrows the following silence, a short one ends early
PACE_MIN=0.85
PACE_MAX=1.15
# Speaker gender classifier (audio); blank = pitch + reviewer only. HF_HOME keeps its weights off the full home disk.
# The source transcript is kept verbatim; set TRANSCRIPT_CHECK=true to let the model correct it
TRANSCRIPT_CHECK=false
GENDER_MODEL=audeering/wav2vec2-large-robust-6-ft-age-gender
FIT_MIN_SPEED=0.9
FIT_MAX_SPEED=1.1
FIT_ROUNDS=4

# ---- Speakers and script ----
# Diarize the Demucs dialogue stem (music removed); an audio LLM (OpenRouter) then checks who says each line
DIARIZE_DIALOGUE_STEM=true
SPEAKER_REVIEW=true
# Check Bodhan transcripts and post-edit Bodhan translations in context (OpenRouter) before any voicing
SCRIPT_SUPERVISION=true

# ---- Lip sync ----
# auto: LatentSync 1.6 on a GPU, Wav2Lip on CPU. Force with latentsync or wav2lip.
LIP_SYNC_ENGINE=auto
LIP_SYNC_MODEL=
LATENTSYNC_STEPS=30
LATENTSYNC_GUIDANCE=1.5
# 16-frame windows denoised together in one UNet batch: identical output, better GPU use (benchmarked on the H100)
LATENTSYNC_WINDOWS=1
# Real-ESRGAN sharpening of the redrawn mouth on close-ups (faces wider than 180 px)
LATENTSYNC_ENHANCE=true
# gfpgan: natural lip/teeth/skin detail on the redrawn lower face (own venv); esrgan: edge sharpening only
LIP_RESTORE=gfpgan
RESTORE_SPLIT_PX=200
# GFPGAN worker processes and Real-ESRGAN threads restoring cached spans side by side
RESTORE_WORKERS=2
# GFPGAN only: 0 = restore every frame on its own (sharpest); 0.3 = carry 30% of the previous frame's restored detail over (measured: flicker +7% -> +4%, mouth sharpness -4% on 320 px faces, -15% on 100 px faces)
RESTORE_TEMPORAL=0
LATENTSYNC_DEEPCACHE=false
FACE_DET_SIZE=640
# Face analysis every Nth frame (1 on a GPU, 2 on CPU when blank)
# Parallel face-analysis workers (blank: one on a GPU, one per 6 CPU cores otherwise)
FACE_WORKERS=
FACE_STRIDE=
# Wav2Lip fallback (CPU, OpenVINO)
WAV2LIP_CHECKPOINT=Wav2Lip/checkpoints/wav2lip_gan.pth
WAV2LIP_ACCURATE_CHECKPOINT=Wav2Lip/checkpoints/wav2lip.pth
MOUTH_ENHANCE=true
ESRGAN_WEIGHTS=Wav2Lip/checkpoints/realesr-general-x4v3.pth
WAV2LIP_CHUNK_SECONDS=15
WAV2LIP_RESIZE_FACTOR=1
WAV2LIP_THREADS=12
LIP_SYNC_RUNTIME=openvino
OPENVINO_DEVICE=CPU

# ---- Diarization ----
# diarizen: DiariZen WavLM-Large + VBx (best open accuracy); sherpa: light ONNX fallback
DIARIZATION_BACKEND=diarizen
DIARIZATION_THREADS=8


# Optional: Netscape cookies.txt from a signed-in browser, for sites (YouTube) that block servers with a bot check
YTDLP_COOKIES=
# every synthesised clip is levelled with the Bodhan engine's recipe (LUFS target, then peak headroom)
TTS_TARGET_RMS=-20.0
TTS_PEAK_DBFS=-1.0
# YouTube downloads: path to a Node >= 22 binary when the node on PATH is older (yt-dlp's JS challenge)
YTDLP_NODE=
